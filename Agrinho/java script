/* ============================================================
   16. OBSERVER PARA CARDS DE TECNOLOGIA (CSS flip)
   ============================================================ */
function initTechFlipObserver() {
  // Acessibilidade: ao tabular para o card, mostra dica no back
  document.querySelectorAll('.tec-card').forEach(card => {
    card.addEventListener('focus', () => {
      card.classList.add('flipped');
      card.querySelector('.tec-card-back').removeAttribute('aria-hidden');
      card.querySelector('.tec-card-front').setAttribute('aria-hidden', 'true');
    });
    card.addEventListener('blur', () => {
      card.classList.remove('flipped');
      card.querySelector('.tec-card-back').setAttribute('aria-hidden', 'true');
      card.querySelector('.tec-card-front').removeAttribute('aria-hidden');
    });
  });
}

